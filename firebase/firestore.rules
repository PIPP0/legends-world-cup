rules_version = '2';
// Legends World Cup: datos del admin en la nube. Mismo modelo que Forma Pro.
// - Admin: solo las cuentas listadas en config/admin.correos, entrando con Google y con correo verificado.
// - Cada visitante (anónimo o con Google) escribe SOLO lo suyo; nadie lee lo de otras personas salvo Admin.
// - config/funciones es público de lectura (la web necesita saber qué funciones están encendidas); solo Admin escribe.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verificado() { return request.auth.token.get('email_verified', false) == true; }
    function miCorreo() { return request.auth.token.get('email', ''); }
    function esAdmin() {
      return signedIn()
        && ((verificado() && request.auth.token.firebase.sign_in_provider == 'google.com')
          // Usuario y contraseña: la cuenta la crea el dueño en Firebase antes de publicar (así nadie más puede registrar ese correo) y su correo debe estar en config/admin.
          || request.auth.token.firebase.sign_in_provider == 'password')
        && exists(/databases/$(database)/documents/config/admin)
        && miCorreo().lower() in get(/databases/$(database)/documents/config/admin).data.correos;
    }

    // Quiénes son administradores: nadie lo lee desde un navegador (la regla lo usa por dentro); solo Admin lo cambia.
    match /config/admin {
      allow read: if false;
      allow write: if esAdmin();
    }
    // Mi Once Ideal: el equipo y las estadísticas del duelo de cada persona con cuenta de Google (para verlos en cualquier dispositivo).
    // Las lee y escribe su dueña; Admin también puede leerlas y editarlas (con aviso a la persona: el campo «editado» marca el cambio).
    match /duelo/{uid} {
      function dueloOk(d) {
        return d.keys().hasOnly(['equipo', 'stats', 'actualizado', 'editado'])
          && (!('equipo' in d) || (d.equipo is map && d.equipo.once is list && d.equipo.once.size() == 11
              && d.equipo.suplentes is list && d.equipo.suplentes.size() <= 3
              && d.equipo.formacion is string && d.equipo.formacion.size() <= 12))
          && (!('stats' in d) || d.stats is map)
          && (!('editado' in d) || d.editado is map);
      }
      function esDuena() { return signedIn() && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      allow get: if esDuena() || esAdmin();
      allow list: if false;
      allow create, update: if (esDuena() || esAdmin()) && dueloOk(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Cupo de cuentas con Google. config/cupo es un contador público de solo lectura; Admin lo crea y lo ajusta. Una persona con Google puede sumarle EXACTAMENTE 1, y solo si
    // en esa misma operación crea su marcador cupos/{uid} (que solo se puede crear una vez): así nadie se cuenta dos veces ni puede inflar o bajar el contador.
    // Es un tope blando: protege el consumo de Firestore; no puede impedir que alguien cree una sesión en Firebase Auth.
    match /config/cupo {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if esAdmin();
      allow update: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['registradas', 'actualizado'])
        && request.resource.data.registradas == resource.data.registradas + 1
        && existsAfter(/databases/$(database)/documents/cupos/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/cupos/$(request.auth.uid))
        && exists(/databases/$(database)/documents/config/funciones)
        && (get(/databases/$(database)/documents/config/funciones).data.valores.get('cupoCuentas', 0) == 0
            || request.resource.data.registradas <= get(/databases/$(database)/documents/config/funciones).data.valores.get('cupoCuentas', 0));
    }
    match /cupos/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['uid', 'creado']) && request.resource.data.uid == uid;
      allow update, delete: if false;
    }
    // Interruptores de funciones: la web los lee sin iniciar sesión; solo Admin los cambia.
    match /config/funciones {
      allow get: if true;
      allow list: if false;
      allow write: if esAdmin() && request.resource.data.keys().hasOnly(['valores', 'actualizado', 'por']);
    }

    // Visitantes y personas con cuenta. Cada uno crea y actualiza el suyo (sin poder cambiar campos ajenos); Admin los lee todos.
    // Ranking del duelo: lectura pública; cada persona escribe solo su documento y únicamente puede sumar una partida por escritura.
    match /ranking/{uid} {
      function rankOk(d) {
        return d.keys().hasOnly(['alias', 'pais', 'puntos', 'ganadas', 'jugadas', 'racha', 'mejorRacha', 'ultimo', 'aliasCambiado'])
          && d.get('aliasCambiado', false) is bool
          && d.alias is string && d.alias.size() >= 1 && d.alias.size() <= 20
          && d.pais is string && d.pais.size() <= 2
          && d.puntos is int && d.ganadas is int && d.jugadas is int && d.racha is int && d.mejorRacha is int
          && d.puntos >= 0 && d.ganadas >= 0 && d.jugadas >= 0 && d.racha >= 0 && d.mejorRacha >= d.racha
          && d.puntos <= 100000 && d.jugadas <= 100000 && d.ganadas <= d.jugadas;
      }
      // El nombre público solo se puede cambiar una vez: al cambiarlo, aliasCambiado pasa a true y ya no vuelve a cambiar.
      function nombreOk(d, prev) {
        return (d.alias == prev.alias && d.get('aliasCambiado', false) == prev.get('aliasCambiado', false))
          || (prev.get('aliasCambiado', false) == false && d.get('aliasCambiado', false) == true)
          // el nombre automático «Jugador XXXX» puede pasar al nombre de la cuenta (nombre + inicial) sin gastar el cambio manual
          || (prev.alias.matches('Jugador [A-Z0-9]{4}') && prev.get('aliasCambiado', false) == false && d.get('aliasCambiado', false) == false);
      }
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid && rankOk(request.resource.data)
        && request.resource.data.jugadas == 1 && request.resource.data.ganadas <= 1 && request.resource.data.puntos <= 7;
      allow update: if signedIn() && request.auth.uid == uid && rankOk(request.resource.data) && nombreOk(request.resource.data, resource.data)
        && ((request.resource.data.jugadas == resource.data.jugadas + 1
              && request.resource.data.ganadas >= resource.data.ganadas && request.resource.data.ganadas <= resource.data.ganadas + 1
              && request.resource.data.puntos >= resource.data.puntos && request.resource.data.puntos <= resource.data.puntos + 7)
            || (request.resource.data.jugadas == resource.data.jugadas && request.resource.data.ganadas == resource.data.ganadas
              && request.resource.data.puntos == resource.data.puntos && request.resource.data.mejorRacha == resource.data.mejorRacha));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nombre', 'foto', 'anonimo', 'creado', 'ultimo', 'visitas', 'idioma', 'dispositivo', 'pais', 'zona', 'sistema', 'navegador', 'pantalla', 'origen', 'idiomaWeb', 'favorita', 'auto', 'inter', 'seg', 'pags'])
        && request.resource.data.uid == uid
        && request.resource.data.get('email', '') in ['', miCorreo()]
        && request.resource.data.get('nombre', '') is string && request.resource.data.get('nombre', '').size() <= 120
        && request.resource.data.get('foto', '') is string && request.resource.data.get('foto', '').size() <= 400
        && request.resource.data.get('visitas', 0) is int && request.resource.data.get('visitas', 0) <= 100000
        && request.resource.data.get('dispositivo', '') is string && request.resource.data.get('dispositivo', '').size() <= 20
        && request.resource.data.get('idioma', '') is string && request.resource.data.get('idioma', '').size() <= 12
        && request.resource.data.get('pais', '') is string && request.resource.data.get('pais', '').size() <= 2
        && request.resource.data.get('zona', '') is string && request.resource.data.get('zona', '').size() <= 40
        && request.resource.data.get('sistema', '') is string && request.resource.data.get('sistema', '').size() <= 20
        && request.resource.data.get('navegador', '') is string && request.resource.data.get('navegador', '').size() <= 20
        && request.resource.data.get('pantalla', '') is string && request.resource.data.get('pantalla', '').size() <= 12
        && request.resource.data.get('origen', '') is string && request.resource.data.get('origen', '').size() <= 40
        && request.resource.data.get('idiomaWeb', '') is string && request.resource.data.get('idiomaWeb', '').size() <= 4
        && request.resource.data.get('auto', false) is bool && request.resource.data.get('inter', false) is bool
        && request.resource.data.get('seg', 0) is int && request.resource.data.get('seg', 0) <= 86400
        && request.resource.data.get('pags', 0) is int && request.resource.data.get('pags', 0) <= 200
        && request.resource.data.get('favorita', '') is string && request.resource.data.get('favorita', '').size() <= 4;
      // Admin puede registrar o completar la ficha de una cuenta de Google (herramienta «Traer cuentas de Google desde Firebase» del panel).
      allow create, update: if esAdmin() && request.resource.data.keys().hasOnly(['uid', 'email', 'nombre', 'foto', 'anonimo', 'creado', 'ultimo', 'visitas', 'idioma', 'dispositivo', 'pais', 'zona', 'sistema', 'navegador', 'pantalla', 'origen', 'idiomaWeb', 'favorita', 'auto', 'inter', 'seg', 'pags'])
        && request.resource.data.uid == uid && request.resource.data.get('anonimo', false) == false
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 200
        && request.resource.data.get('nombre', '') is string && request.resource.data.get('nombre', '').size() <= 120
        && request.resource.data.get('foto', '') is string && request.resource.data.get('foto', '').size() <= 400
        && request.resource.data.get('creado', 0) is int && request.resource.data.get('ultimo', 0) is int;
      allow read: if (signedIn() && request.auth.uid == uid) || esAdmin();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Progreso de la historia oficial (hasta qué fase avanzó cada persona): lo escribe y lee la propia cuenta; Admin lee.
    match /progreso/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nivel', 'actualizado'])
        && request.resource.data.nivel is int && request.resource.data.nivel >= 0 && request.resource.data.nivel <= 4;
      allow read: if (signedIn() && request.auth.uid == uid) || esAdmin();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // ¿De acuerdo con el campeón? Un voto por cuenta (hay que entrar con Google); solo ella y Admin leen su voto; los contadores son públicos y solo suben o bajan de a 1.
    match /acuerdoVotos/{uid} {
      allow create, update: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['voto', 'creada'])
        && request.resource.data.voto in ['si', 'no'] && request.resource.data.creada is int;
      allow read: if (signedIn() && request.auth.uid == uid) || esAdmin();
      allow delete: if esAdmin();
    }
    match /acuerdoConteo/{id} {
      allow read: if true;
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && id == 'campeon' && request.resource.data.keys().hasOnly(['si', 'no'])
        && request.resource.data.si is int && request.resource.data.no is int
        && request.resource.data.si >= 0 && request.resource.data.si <= 1 && request.resource.data.no >= 0 && request.resource.data.no <= 1;
      allow update: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && request.resource.data.keys().hasOnly(['si', 'no'])
        && request.resource.data.si is int && request.resource.data.no is int
        && request.resource.data.si >= 0 && request.resource.data.no >= 0
        && request.resource.data.si - resource.data.si in [-1, 0, 1] && request.resource.data.no - resource.data.no in [-1, 0, 1];
      allow delete: if esAdmin();
    }
    // MVP: cada persona guarda su voto (solo ella y Admin lo leen); los contadores por jugador son públicos y solo suben o bajan de a 1.
    match /mvpVotos/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['jugador', 'creada'])
        && request.resource.data.jugador is string && request.resource.data.jugador.size() >= 1 && request.resource.data.jugador.size() <= 60
        && request.resource.data.creada is int;
      allow read: if (signedIn() && request.auth.uid == uid) || esAdmin();
      allow delete: if esAdmin();
    }
    match /mvpConteo/{id} {
      allow read: if true;
      allow create: if signedIn() && id.size() <= 60 && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int && request.resource.data.n >= 0
        && (request.resource.data.n == resource.data.n + 1 || request.resource.data.n == resource.data.n - 1);
      allow delete: if esAdmin();
    }
    // Encuestas de satisfacción: cada persona crea las suyas; solo Admin las lee. Nunca se editan.
    match /encuestas/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'tipo', 'estrellas', 'estrellas2', 'comentario', 'datos', 'pantalla', 'creada'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['general', 'mundial']
        && request.resource.data.estrellas is int && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5
        && request.resource.data.get('estrellas2', 1) is int && request.resource.data.get('estrellas2', 1) >= 1 && request.resource.data.get('estrellas2', 1) <= 5
        && request.resource.data.get('comentario', '') is string && request.resource.data.get('comentario', '').size() <= 400
        && request.resource.data.get('datos', '') is string && request.resource.data.get('datos', '').size() <= 160
        && request.resource.data.get('pantalla', '') is string && request.resource.data.get('pantalla', '').size() <= 40
        && request.resource.data.creada is int;
      allow read: if esAdmin();
      allow update: if false;
      allow delete: if esAdmin();
    }
    // Mundiales simulados (sede, fecha, clima, campeón…): para las métricas de Admin. Se crean y nunca se editan.
    match /mundiales/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'sede', 'mes', 'clima', 'primes', 'formato', 'campeon', 'semilla', 'creada'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sede is string && request.resource.data.sede.size() <= 20
        && request.resource.data.mes is int && request.resource.data.mes >= 0 && request.resource.data.mes <= 12
        && request.resource.data.clima is string && request.resource.data.clima.size() <= 12
        && request.resource.data.primes is int && request.resource.data.primes >= 0 && request.resource.data.primes <= 3
        && request.resource.data.formato in ['completo', 'octavos']
        && request.resource.data.campeon is string && request.resource.data.campeon.size() <= 12
        && request.resource.data.semilla is string && request.resource.data.semilla.size() <= 40
        && request.resource.data.creada is int;
      allow read: if esAdmin();
      allow update: if false;
      allow delete: if esAdmin();
    }
    // Todo lo demás, cerrado.
    match /{document=**} { allow read, write: if false; }
  }
}
